# Neon (see MIGRATION_PLAN.md) — required for every app/api/* route.
DATABASE_URL=postgres://user:password@host/dbname
NEON_AUTH_BASE_URL=https://your-neon-auth-domain
# Any random 32+ character string, generated once — not tied to any account.
NEON_AUTH_COOKIE_SECRET=

# Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=

# OPTIONAL — when set, the text-only Haiku-class tasks (bucket suggestions,
# worksheet tab matching) run on GPT-6 Luna; unset, they stay on Anthropic. Add
# it to Preview only first; Production keeps Haiku until the Preview output
# looks right. Server-side only.
OPENAI_API_KEY=
# Set to 1 to send every task back to Anthropic at once (kill switch).
AI_FORCE_ANTHROPIC=

# MCP connector (app/api/mcp) — the server calls its own app/api/** routes
# with an absolute URL when it's not running in the browser. Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL automatically; only set
# APP_BASE_URL to override that (a real custom domain, or running the
# connector against something other than Vercel).
APP_BASE_URL=
